{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "draftboard-dev",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "next",
        "dev",
        "-p",
        "3000"
      ],
      "port": 3000,
      "env": {
        "DEV_USER": "admin@example.com",
        "ADMIN_EMAILS": "admin@example.com",
        "ALLOWED_EMAIL_DOMAINS": "example.com",
        "AUTH_SECRET": "local-dev-only-not-a-secret",
        "APP_URL": "http://localhost:3000"
      }
    }
  ]
}
