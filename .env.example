# Copy to .env.local for local development (npm run dev), and add the same names to your host (Vercel → Settings →
# Environment Variables) for production. Never commit real values. The setup skill walks you through each one.

# ---- Local development shortcuts (ignored in production) ----
# Sign in as this person without Google. Leave DATABASE_URL and BLOB_READ_WRITE_TOKEN unset locally to use the
# built-in database (.data/pglite) and save uploads to .data/uploads.
DEV_USER=you@yourcompany.com

# ---- Site ----
# Public address of the deployed site, no trailing slash (used for share links, Slack links and the X callback).
# On Vercel it defaults to the production domain; set it if you use a custom domain.
APP_URL=http://localhost:3000

# ---- Who can sign in ----
# Everyone on these domains can sign in (comma-separated). Admins invite anyone else (an agency) in Settings → People.
ALLOWED_EMAIL_DOMAINS=yourcompany.com
# The first admins (they can make more in the app): connect X, invite people, post and schedule.
ADMIN_EMAILS=you@yourcompany.com
# Optional individual addresses outside those domains. Usually leave empty and invite people in the app instead.
ALLOWED_EMAILS=

# ---- Google sign-in (Auth.js) ----  docs/google-oauth.md
# AUTH_SECRET: any long random string (`npx auth secret` or `openssl rand -base64 32`). Also encrypts the X tokens.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ---- Email sign-in links and invite emails (optional) ----  docs/people.md
# Lets people without a Google account (e.g. an agency) sign in with a one-time email link, and emails invites.
AUTH_RESEND_KEY=
EMAIL_FROM=

# ---- Database ----  any Postgres (Neon, Supabase, ...). Tables are created automatically.
DATABASE_URL=

# ---- Media storage ----  Vercel Blob (Storage → Blob → connect to the project adds this for you).
BLOB_READ_WRITE_TOKEN=

# ---- X (posting and scheduling) ----  docs/x-api.md
# From your app at developer.x.com → Keys and tokens → OAuth 2.0 Client ID and Client Secret.
X_CLIENT_ID=
X_CLIENT_SECRET=
# Optional app-only bearer token used to check @handles in drafts (otherwise the connected account's token is used).
X_BEARER_TOKEN=
# Set to "off" to never look up @handles on X (each lookup is a billed API read).
X_CHECK_HANDLES=

# ---- Scheduler ----  docs/scheduling.md
# Any long random string. Vercel sends it to /api/cron/publish automatically; other pingers send it as a Bearer token.
CRON_SECRET=

# ---- Slack notifications (optional) ----  docs/slack.md
SLACK_BOT_TOKEN=
# email=SlackMemberID pairs, comma-separated: ana@yourcompany.com=U01ABCDEF,ben@yourcompany.com=U02GHIJKL
SLACK_USERS=
